# POST endpoint for the "Start a project" inquiry form.
# Compatible with a Formspree or Web3Forms endpoint that accepts JSON.
# Leave unset in development to see the inline configuration message.
VITE_INQUIRY_ENDPOINT=

# Optional privacy-respecting analytics (e.g. Plausible). Both must be set
# together, or neither loads and no analytics script is injected.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_DOMAIN=
